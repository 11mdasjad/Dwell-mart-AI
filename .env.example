# ===========================================
# Dwell Mart AI Agent — Environment Variables
# ===========================================

# ── AI Mode Selection ──
# Set to 'true' to force mock mode even if an API key is present
AI_MOCK_MODE=true

# Provider options: "gemini" | "openai" | "mock"
AI_PROVIDER=gemini

# ── Google Gemini Configuration (Required when AI_PROVIDER=gemini) ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ── OpenAI Configuration (Required when AI_PROVIDER=openai) ──
# Server-only secret key — NEVER prefix with NEXT_PUBLIC_
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
AI_MODEL=gemini-3.6-flash

# AI Provider Request Timeout in milliseconds (default: 30000)
AI_TIMEOUT_MS=30000

# ── Application Settings ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Dwell Mart AI

# ── Catalog Synchronization & Grounding ──
DATA_SOURCE=live
ENABLE_MOCK_MODE=false
DWELLMART_API_BASE_URL=https://dwellmart.in/api
DWELLMART_SITE_URL=https://dwellmart.in
CATALOG_SYNC_INTERVAL_HOURS=6
MAX_SYNC_RETRIES=3
SYNC_TIMEOUT_MS=15000
